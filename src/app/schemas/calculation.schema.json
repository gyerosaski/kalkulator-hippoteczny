{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "calculation.schema.json",
  "title": "Kalkulacja hipoteczna — dane formularza",
  "description": "Schemat struktury danych zapisanej kalkulacji hipotecznej (getRawValue() formularza).",
  "type": "object",
  "required": ["basicData", "ratePeriods", "overheadCosts", "tranches", "prepayments"],
  "properties": {
    "basicData": { "$ref": "#/$defs/BasicData" },
    "ratePeriods": { "$ref": "#/$defs/RatePeriodsSection" },
    "overheadCosts": { "$ref": "#/$defs/OverheadCostsSection" },
    "tranches": { "$ref": "#/$defs/TranchesSection" },
    "prepayments": { "$ref": "#/$defs/PrepaymentsSection" }
  },
  "$defs": {
    "YyyyMm": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "Data w formacie RRRR-MM"
    },
    "YyyyMmOrEmpty": {
      "anyOf": [{ "$ref": "#/$defs/YyyyMm" }, { "type": "string", "maxLength": 0 }]
    },
    "InstallmentType": {
      "type": "string",
      "enum": ["EQUAL", "DECREASING"]
    },
    "RateType": {
      "type": "string",
      "enum": ["VARIABLE", "FIXED"]
    },
    "InsuranceFrequency": {
      "type": "string",
      "enum": ["YEARLY", "MONTHLY", "ONE_TIME"]
    },
    "InsuranceCalcMethod": {
      "type": "string",
      "enum": ["PCT_PROPERTY_VALUE", "PCT_LOAN_AMOUNT", "PCT_BALANCE", "FIXED_AMOUNT"]
    },
    "LifeInsuranceCalcMethod": {
      "type": "string",
      "enum": ["PCT_LOAN_AMOUNT", "PCT_BALANCE", "FIXED_AMOUNT"]
    },
    "PrepaymentFrequency": {
      "type": "string",
      "enum": ["ONE_TIME", "MONTHLY", "QUARTERLY", "YEARLY"]
    },
    "PrepaymentEffect": {
      "type": "string",
      "enum": ["LOWER_INSTALLMENT", "SHORTEN_PERIOD"]
    },
    "RatePeriod": {
      "type": "object",
      "required": ["from", "rateType", "nominalRate", "wibor", "margin"],
      "properties": {
        "from": { "$ref": "#/$defs/YyyyMm" },
        "rateType": { "$ref": "#/$defs/RateType" },
        "nominalRate": { "type": "number", "minimum": 0 },
        "wibor": { "type": "number", "minimum": 0 },
        "margin": { "type": "number", "minimum": 0 }
      }
    },
    "RatePeriodsSection": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/RatePeriod" }
        }
      }
    },
    "BasicData": {
      "type": "object",
      "required": [
        "propertyValue",
        "loanAmount",
        "ltv",
        "loanPeriod",
        "startDate",
        "capitalStartDate",
        "installmentType"
      ],
      "properties": {
        "propertyValue": { "type": "number", "exclusiveMinimum": 0 },
        "loanAmount": { "type": "number", "exclusiveMinimum": 0 },
        "ltv": { "type": "number", "minimum": 0, "maximum": 100 },
        "loanPeriod": { "type": "integer", "minimum": 1 },
        "startDate": { "$ref": "#/$defs/YyyyMm" },
        "capitalStartDate": { "$ref": "#/$defs/YyyyMm" },
        "installmentType": { "$ref": "#/$defs/InstallmentType" }
      }
    },
    "AdditionalCost": {
      "type": "object",
      "required": ["name", "frequency", "calcMethod", "value", "from", "to"],
      "properties": {
        "name": { "type": "string" },
        "frequency": { "$ref": "#/$defs/InsuranceFrequency" },
        "calcMethod": { "$ref": "#/$defs/LifeInsuranceCalcMethod" },
        "value": { "type": "number", "minimum": 0 },
        "from": { "$ref": "#/$defs/YyyyMm" },
        "to": { "$ref": "#/$defs/YyyyMm" }
      }
    },
    "OverheadCostsFields": {
      "type": "object",
      "required": [
        "commission",
        "appraisal",
        "bridge",
        "propertyInsurance",
        "lowEquityInsurance",
        "lifeInsurance",
        "jobLossInsurance",
        "additionalCosts",
        "promoRate"
      ],
      "properties": {
        "commission": {
          "type": "object",
          "required": ["commissionValue", "commissionCalcMethod"],
          "properties": {
            "commissionValue": { "type": "number", "minimum": 0 },
            "commissionCalcMethod": { "type": "string", "enum": ["PERCENTAGE", "FIXED_AMOUNT"] }
          }
        },
        "appraisal": {
          "type": "object",
          "required": ["appraisalFee"],
          "properties": {
            "appraisalFee": { "type": "number", "minimum": 0 }
          }
        },
        "bridge": {
          "type": "object",
          "required": ["bridgeRateIncrease", "bridgeMonths"],
          "properties": {
            "bridgeRateIncrease": { "type": "number", "minimum": 0 },
            "bridgeMonths": { "type": "integer", "minimum": 0 }
          }
        },
        "propertyInsurance": {
          "type": "object",
          "required": [
            "propInsFrequency",
            "propInsCalcMethod",
            "propInsValue",
            "propInsFrom",
            "propInsTo"
          ],
          "properties": {
            "propInsFrequency": { "$ref": "#/$defs/InsuranceFrequency" },
            "propInsCalcMethod": { "$ref": "#/$defs/InsuranceCalcMethod" },
            "propInsValue": { "type": "number", "minimum": 0 },
            "propInsFrom": { "$ref": "#/$defs/YyyyMm" },
            "propInsTo": { "$ref": "#/$defs/YyyyMm" }
          }
        },
        "lowEquityInsurance": {
          "type": "object",
          "required": ["lowEquityRateIncrease"],
          "properties": {
            "lowEquityRateIncrease": { "type": "number", "minimum": 0 }
          }
        },
        "lifeInsurance": {
          "type": "object",
          "required": [
            "lifeInsFrequency",
            "lifeInsCalcMethod",
            "lifeInsValue",
            "lifeInsFrom",
            "lifeInsTo"
          ],
          "properties": {
            "lifeInsFrequency": { "$ref": "#/$defs/InsuranceFrequency" },
            "lifeInsCalcMethod": { "$ref": "#/$defs/LifeInsuranceCalcMethod" },
            "lifeInsValue": { "type": "number", "minimum": 0 },
            "lifeInsFrom": { "$ref": "#/$defs/YyyyMm" },
            "lifeInsTo": { "$ref": "#/$defs/YyyyMm" }
          }
        },
        "jobLossInsurance": {
          "type": "object",
          "required": [
            "jobLossInsFrequency",
            "jobLossInsCalcMethod",
            "jobLossInsValue",
            "jobLossInsFrom",
            "jobLossInsTo"
          ],
          "properties": {
            "jobLossInsFrequency": { "$ref": "#/$defs/InsuranceFrequency" },
            "jobLossInsCalcMethod": { "$ref": "#/$defs/LifeInsuranceCalcMethod" },
            "jobLossInsValue": { "type": "number", "minimum": 0 },
            "jobLossInsFrom": { "$ref": "#/$defs/YyyyMm" },
            "jobLossInsTo": { "$ref": "#/$defs/YyyyMm" }
          }
        },
        "additionalCosts": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/AdditionalCost" }
            }
          }
        },
        "promoRate": {
          "type": "object",
          "required": ["promoRateDecrease", "promoFrom", "promoTo"],
          "properties": {
            "promoRateDecrease": { "type": "number", "minimum": 0 },
            "promoFrom": { "$ref": "#/$defs/YyyyMm" },
            "promoTo": { "$ref": "#/$defs/YyyyMm" }
          }
        }
      }
    },
    "OverheadCostsSection": {
      "type": "object",
      "required": ["enabled", "fields"],
      "properties": {
        "enabled": { "type": "boolean" },
        "fields": { "$ref": "#/$defs/OverheadCostsFields" }
      }
    },
    "Tranche": {
      "type": "object",
      "required": ["amount", "date", "disbursementFee"],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "date": { "$ref": "#/$defs/YyyyMm" },
        "disbursementFee": { "type": "number", "minimum": 0 }
      }
    },
    "TranchesSection": {
      "type": "object",
      "required": ["enabled", "fields"],
      "properties": {
        "enabled": { "type": "boolean" },
        "fields": {
          "type": "object",
          "required": ["tranches"],
          "properties": {
            "tranches": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/Tranche" }
            }
          }
        }
      }
    },
    "PrepaymentRule": {
      "type": "object",
      "required": ["frequency", "from", "to", "amount", "effect"],
      "properties": {
        "frequency": { "$ref": "#/$defs/PrepaymentFrequency" },
        "from": { "$ref": "#/$defs/YyyyMm" },
        "to": { "$ref": "#/$defs/YyyyMmOrEmpty" },
        "amount": { "type": "number", "minimum": 0 },
        "effect": { "$ref": "#/$defs/PrepaymentEffect" }
      }
    },
    "TargetInstallmentRule": {
      "type": "object",
      "required": ["targetRate", "from", "to", "effect"],
      "properties": {
        "targetRate": { "type": "number", "minimum": 0 },
        "from": { "$ref": "#/$defs/YyyyMm" },
        "to": { "$ref": "#/$defs/YyyyMm" },
        "effect": { "$ref": "#/$defs/PrepaymentEffect" }
      }
    },
    "EarlyRepaymentCommission": {
      "type": "object",
      "required": ["ratePct", "validUntil"],
      "properties": {
        "ratePct": { "type": "number", "minimum": 0 },
        "validUntil": { "$ref": "#/$defs/YyyyMm" }
      }
    },
    "PrepaymentsSection": {
      "type": "object",
      "required": ["enabled", "fields"],
      "properties": {
        "enabled": { "type": "boolean" },
        "fields": {
          "type": "object",
          "required": ["prepaymentRules", "rataDocelowaRegula", "prowizjaWczesniejszaSplata"],
          "properties": {
            "prepaymentRules": {
              "type": "object",
              "required": ["items"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/PrepaymentRule" }
                }
              }
            },
            "rataDocelowaRegula": { "$ref": "#/$defs/TargetInstallmentRule" },
            "prowizjaWczesniejszaSplata": { "$ref": "#/$defs/EarlyRepaymentCommission" }
          }
        }
      }
    }
  }
}
