{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Domyślne uprawnienia dla głównego okna aplikacji",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$DOCUMENT/**/*.json" },
        { "path": "$DOWNLOAD/**/*.json" },
        { "path": "$DESKTOP/**/*.json" },
        { "path": "$HOME/**/*.json" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$DOCUMENT/**/*.json" },
        { "path": "$DOWNLOAD/**/*.json" },
        { "path": "$DESKTOP/**/*.json" },
        { "path": "$HOME/**/*.json" }
      ]
    }
  ]
}
